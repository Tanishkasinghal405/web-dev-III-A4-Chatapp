# Copy this file to ".env" and fill in your own values.
# The ".env" file is private. Never share it and never upload it to GitHub.

# Port the server listens on (your original app used 8080)
PORT=8080

# Your MongoDB Atlas connection string (see README, Part 2).
# Replace <username>, <password> and the cluster address with your own.
# The "/chatapp" part is the database name; MongoDB creates it automatically.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/chatapp?retryWrites=true&w=majority

# A long random secret used to sign login tokens (JWT).
# Generate one by running this in your terminal:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# Optional: a message shown to every user when they connect (the "announce" event)
ANNOUNCEMENT=Welcome to ChatApp! Your messages are saved securely.
